# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# scripts/load_env.py reads this at build time and turns every key into a -D
# define, before compilation. Everything in include/config.h is #ifndef-guarded,
# so anything set here wins and anything omitted keeps the default there.
#
# Accepted forms: KEY=VALUE, KEY = VALUE, and a bare `KEY "VALUE"` (which is
# what you get by copying a #define line out of config.h and deleting the word
# #define). Unquoted numbers and true/false pass through as C literals.

# --- WiFi ------------------------------------------------------------------
# 2.4 GHz only. The ESP32-WROOM-32D has no 5 GHz radio, so a router that merges
# both bands under one SSID may need the 2.4 GHz band split out.
WIFI_SSID="your network"
WIFI_PASSWORD="your password"

# --- Trains ----------------------------------------------------------------
# RealTimeTrains v2: https://realtimetrains.github.io/api-specification/
# Registration issues a long-life *refresh* token (a JWT), which the firmware
# swaps for a short-life access token on every fetch.
#
# Note this is NOT the old api.rtt.io v1 username/password pair - those 401
# against v2, which changed host, auth scheme and response shape at once.
RTT_REFRESH_TOKEN="ey..."

# --- Optional overrides ----------------------------------------------------
# Anything else from include/config.h can be set here too, which is the tidiest
# way to point the board at your own stations without editing tracked files.
#
# WEATHER_LAT=51.4406
# WEATHER_LON=-0.0879
# WEATHER_PLACE="West Dulwich"
# STATION_1_CRS="WDU"
# STATION_1_NAME="West Dulwich"
# STATION_1_FILTER="London Victoria"
# STATION_2_CRS="TUH"
# STATION_2_NAME="Tulse Hill"
# STATION_2_FILTER="Bedford|London Bridge|St Pancras"
